# Cabeçalhos dos assets estáticos (Cloudflare Workers).
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# O corpus, o index.json e o novidades.json são lidos de outros domínios
# (o cron da Clara, o botão "?" e o aviso de novidades dentro da plataforma).
/corpus/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/index.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/novidades.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/interno/*
  X-Robots-Tag: noindex
