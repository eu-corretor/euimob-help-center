---
// Ícone de traço da central. Decorativo por padrão (aria-hidden); passe
// `label` quando o ícone for a única indicação de significado.
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<svg
  class:list={["eu-icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={ICONS[name]}
/>
