---
// "Revisado em <data> · versão <x>" antes do rodapé padrão (anterior/próximo),
// e a saída para quando o guia não resolveu: perguntar à Clara.
import Default from "@astrojs/starlight/components/Footer.astro";

const { entry } = Astro.locals.starlightRoute;
const { verificado_em, versao_sistema, hero } = entry.data;
const revisado = verificado_em?.toLocaleDateString("pt-BR", { timeZone: "UTC" });
---

{
  revisado && (
    <p class="eu-verified">
      Revisado em {revisado}
      {versao_sistema && ` · versão ${versao_sistema}`}
    </p>
  )
}
<Default><slot /></Default>
{
  !hero && (
    <p class="eu-footer-help">
      Não resolveu? Pergunte à Clara dentro do sistema, em <strong>Conversas → Clara</strong>.
    </p>
  )
}
