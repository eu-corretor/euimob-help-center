---
/**
 * Player de vídeo: YouTube (com capítulos clicáveis) ou Google Drive.
 * No YouTube, `?t=<segundos>` na URL (é assim que a Clara aponta "vá ao
 * minuto 2:40") inicia o vídeo naquele ponto; clicar num capítulo faz o mesmo
 * e marca o capítulo como o atual. O player do Drive não aceita começar num
 * minuto, então vídeos do Drive aparecem sem capítulos.
 */
import { getEntry } from "astro:content";

import Icon from "./Icon.astro";

interface Props {
  slug: string;
  label?: string;
}

const { slug, label = "Vídeo do guia" } = Astro.props;
const video = await getEntry("videos", slug);
if (!video) {
  throw new Error(`O guia cita o vídeo "${slug}", mas não existe src/content/videos/${slug}.yaml`);
}
const { youtube_id, drive_id, duracao } = video.data;
const capitulos = youtube_id ? video.data.capitulos : [];
const toSeconds = (t: string) => t.split(":").reduce((acc, part) => acc * 60 + Number(part), 0);
const embed = youtube_id
  ? `https://www.youtube-nocookie.com/embed/${youtube_id}?rel=0`
  : `https://drive.google.com/file/d/${drive_id}/preview`;
---

<section class:list={["eu-video", { "eu-video--solo": capitulos.length === 0 }]} data-embed={youtube_id ? embed : undefined} aria-label={label}>
  <div class="eu-video__frame">
    <iframe
      src={embed}
      title={`${label} (${duracao})`}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture; fullscreen"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
  <div class="eu-video__side">
    <p class="eu-video__meta">
      <Icon name="play" size={16} /> Vídeo · {duracao}{capitulos.length > 0 && ` · ${capitulos.length} capítulos`}
    </p>
    {capitulos.length > 0 && (
      <ol class="eu-video__chapters">
        {capitulos.map((c) => (
          <li>
            <a href={`?t=${toSeconds(c.t)}`} data-t={toSeconds(c.t)}>
              <time>{c.t}</time>
              <span>{c.assunto}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".eu-video[data-embed]").forEach((root) => {
    const frame = root.querySelector("iframe");
    if (!frame) return;
    const links = [...root.querySelectorAll<HTMLAnchorElement>(".eu-video__chapters a")];

    const markCurrent = (seconds: number) => {
      const current = links.filter((a) => Number(a.dataset.t) <= seconds).at(-1);
      links.forEach((a) => (a === current ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
    };
    const seek = (seconds: number, autoplay: boolean) => {
      frame.src = `${root.dataset.embed}&start=${seconds}${autoplay ? "&autoplay=1" : ""}`;
      markCurrent(seconds);
    };

    const t = Number(new URLSearchParams(location.search).get("t"));
    if (t > 0) {
      seek(t, true);
      root.scrollIntoView({ block: "center" });
    }
    links.forEach((a) => {
      a.addEventListener("click", (event) => {
        event.preventDefault();
        const seconds = Number(a.dataset.t);
        seek(seconds, true);
        history.replaceState(null, "", `?t=${seconds}`);
      });
    });
  });
</script>
